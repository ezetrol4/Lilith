# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyasını git'e commit ETMEYİN.

# Güçlü bir rastgele anahtar üretin:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=buraya-guclu-bir-secret-key-yazin

# Geliştirme: True, Production: False
DJANGO_DEBUG=True

# Production'da kullanılacak host adları (virgülle ayırın)
# Örnek: DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost
